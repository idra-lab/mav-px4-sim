<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="large_square_room">
    <physics type="ode">
      <gravity>0.000000 0.000000 -9.810000</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.000000</sor>
        </solver>
        <constraints>
          <cfm>0.000000</cfm>
          <erp>0.200000</erp>
          <contact_max_correcting_vel>100.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.000000</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000.000000</real_time_update_rate>
      <max_step_size>0.001000</max_step_size>
      <real_time_factor>1.000000</real_time_factor>
      <max_contacts>20</max_contacts>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system" />
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system" />
    <plugin name="gz::sim::systems::AirSpeed" filename="gz-sim-air-speed-system" />
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system" />
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system" />
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system" />

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>46.06712712661159</latitude_deg>
      <longitude_deg> 11.149827878411065</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0.000000 0.000000 10.000000 0.000000 0.000000 0.000000</pose>
      <diffuse>0.800000 0.800000 0.800000 1.000000</diffuse>
      <specular>0.200000 0.200000 0.200000 1.000000</specular>
      <attenuation>
        <range>1000.000000</range>
        <constant>0.900000</constant>
        <linear>0.010000</linear>
        <quadratic>0.001000</quadratic>
      </attenuation>
      <visualize>false</visualize>
      <direction>0.500000 0.100000 -0.900000</direction>
    </light>

    <!-- Room: 12m x 12m floor, 10m high untextured walls -->
    <model name="room">
      <static>true</static>

      <!-- Floor -->
      <link name="floor">
        <pose>0 0 0 0 0 0</pose>
        <collision name="floor_collision">
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <material>
            <!-- untextured gray -->
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>

      <!-- North wall -->
      <link name="wall_north">
        <pose>0 20 2.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>40 0.5 5.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>40 0.5 5.0</size></box></geometry>
          <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>

      <!-- South wall -->
      <link name="wall_south">
        <pose>0 -20 2.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>40 0.5 5.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>40 0.5 5.0</size></box></geometry>
          <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>

      <!-- East wall -->
      <link name="wall_east">
        <pose>20 0 2.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.5 40 5.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.5 40 5.0</size></box></geometry>
          <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>

      <!-- West wall -->
      <link name="wall_west">
        <pose>-20 0 2.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.5 40 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 40 5.0</size></box></geometry>
          <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>
    </model> 

    <!-- Textured obstacle: 1m cube with heavy texture -->
    <model name="obstacle_textured1">
      <static>true</static>
      <pose>0.0 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 1.0 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
            <geometry><box><size>0.5 1.0 4.0</size></box></geometry>
            <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>
    </model>

    <!-- Textured obstacle: 1m cube with heavy texture -->
    <model name="obstacle_textured2">
      <static>true</static>
      <pose>-2.0 -2.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
            <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
            <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>
    </model>

    <!-- Textured obstacle: 1m cube with heavy texture -->
    <model name="end_obstacle_textured">
      <static>true</static>
      <pose>10.0 -0.0 2.5.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 20.0 5.0</size></box></geometry>
        </collision>
        <visual name="visual">
            <geometry><box><size>1.0 20.0 5.0</size></box></geometry>
            <material>
                <double_sided>true</double_sided>
                <diffuse>1.0 1.0 1.0</diffuse>
                <script>
                    <uri>file://materials/scripts</uri>
                    <uri>file://materials/textures</uri>
                    <name>checker/Squares</name>
                </script>
                <pbr>
                    <metal>
                        <albedo_map>file://materials/textures/checker.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
      </link>
    </model>

    <!-- Untextured obstacle: 1m cube with flat color -->
    <!-- <model name="obstacle_untextured">
      <static>true</static>
      <pose>0 6 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 5 5</size></box></geometry>
        </collision>
        <visual name="visual">
            <geometry><box><size>5 5 5</size></box></geometry>
            <material>
                <ambient>0.85 0.85 0.85 1</ambient>
                <diffuse>0.85 0.85 0.85 1</diffuse>
                <specular>0 0 0 1</specular>
                <emissive>0 0 0 1</emissive>
            </material>
        </visual>
      </link>
    </model> -->

    <gui>
      <camera name="user_camera">
        <pose>0 -20 8 0.3 0.3 0</pose>
      </camera>
    </gui>
  </world>
</sdf>
